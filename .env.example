# Solomon Empire - Environment Configuration
# Copy this file to .env and fill in your credentials
# Systems run in mock/demo mode without these - that's OK!

# === OPTIONAL API KEYS ===

# Anthropic Claude (for AI content generation)
ANTHROPIC_API_KEY=

# Telegram (for notifications)
TELEGRAM_BOT_TOKEN=

# Shopify (to sync with your real store)
SHOPIFY_STORE_URL=https://your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_SECRET=

# Instagram (for automated posting)
INSTAGRAM_USERNAME=@rubinfuimaono
INSTAGRAM_GRAPH_TOKEN=

# Email
GMAIL_USER=rubinfui5@gmail.com

# Other integrations
OPENCLAW_API_KEY=
HEYGEN_API_KEY=
ELEVENLABS_API_KEY=
TIDIO_API_KEY=

# === PORT CONFIGURATION (defaults shown) ===
MISSION_CONTROL_PORT=8080
API_SERVER_PORT=5001
